# autotest_framework 环境配置模板
# 复制为 .env 后修改。当前默认值针对 ihomy 本地开发环境。

# 被测系统地址(ihomy 后端,context-path=/api)
AUTOTEST_API_BASE_URL=http://localhost:8080/api

# ihomy 登录凭证(session 级 auth fixture 用)
AUTOTEST_API_EMAIL=admin@ihomy.local
AUTOTEST_API_PASSWORD=admin123
# 开发环境固定验证码(后端 external.yml app.captcha-fixed-code=qwer)
AUTOTEST_CAPTCHA_CODE=qwer

# UI 测试地址(ihomy 前端 Vite dev server)
AUTOTEST_UI_BASE_URL=http://localhost:5173
AUTOTEST_HEADLESS=true

# 可选:直接提供 token 则 auth fixture 跳过登录(用于调试)
# AUTOTEST_API_TOKEN=
